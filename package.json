{
  "name": "dayline",
  "version": "0.2.0",
  "private": true,
  "description": "Calendar-first offline todo widget for Windows",
  "author": "Dayline",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "build:icon": "node scripts/build-icon.mjs",
    "test": "vitest run && node --test electron/database.node-test.cjs",
    "test:db": "node --test electron/database.node-test.cjs",
    "test:watch": "vitest",
    "qa:capture": "npm run build && electron scripts/capture-electron.cjs",
    "qa:database": "electron scripts/check-electron-database.cjs && electron scripts/qa-electron-database-ipc.cjs",
    "dist:setup": "npm run build && electron-builder --win nsis --x64 --config.win.artifactName=Dayline-Setup-${version}-${arch}.${ext}",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --config.win.artifactName=Dayline-Setup-${version}-${arch}.${ext} && electron-builder --win portable --x64 --config.win.artifactName=Dayline-Portable-${version}-${arch}.${ext}",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.dayline.desktop",
    "productName": "Dayline",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dayline",
      "installerLanguages": ["ko_KR", "en_US"],
      "language": "1042"
    }
  }
}
